# MongoDB Atlas connection string (same as public app)
MONGODB_URI=

# Vercel Blob storage token (needed to fetch EPUBs)
BLOB_READ_WRITE_TOKEN=

# Base URL for self-invocation (dispatch-chapters → chapter-extraction)
# Production: https://<pipeline-app>.vercel.app
# Development: http://localhost:3001
PIPELINE_BASE_URL=http://localhost:3001
