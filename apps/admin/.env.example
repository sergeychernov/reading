# MongoDB Atlas connection string (same as public and pipeline)
MONGODB_URI=

# Must be the SAME token as in the app that uploads EPUBs (e.g. apps/public).
# Blobs are uploaded by public; admin downloads them for the pipeline — 403 if tokens differ.
BLOB_READ_WRITE_TOKEN=

# EPUB download timeout in ms (default 2 h; slow local access to Blob may need more)
# EPUB_DOWNLOAD_TIMEOUT_MS=7200000

# HTTP Basic Auth credentials for the admin panel
ADMIN_USER=admin
ADMIN_PASSWORD=

# Pipeline API base URL (used for dispatching chapter extraction)
PIPELINE_API_URL=http://localhost:3001

# Vercel AI Gateway — required when LLM config is set to "gateway" adapter.
# Used by chapter-processing pipeline for idiom/phrasal-verb/rare-word extraction.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
