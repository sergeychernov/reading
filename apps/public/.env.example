# Set to "true" to disable Google OAuth (useful for local development)
AUTH_DISABLED=

# MongoDB Atlas connection string
MONGODB_URI=

# Vercel Blob storage token
BLOB_READ_WRITE_TOKEN=

# NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pipeline API URL (NestJS pipeline service)
# Local: http://localhost:3001, Vercel: https://your-pipeline.vercel.app
PIPELINE_API_URL=http://localhost:3001
