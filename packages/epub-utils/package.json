{
	"name": "@reading/epub-utils",
	"version": "0.0.0",
	"private": true,
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"watch": "tsc --watch --preserveWatchOutput",
		"prepare": "tsc",
		"typecheck": "tsc --noEmit",
		"lint": "tsc --noEmit"
	},
	"dependencies": {
		"@storyteller-platform/epub": "^0.4.7",
		"htmlparser2": "^10.1.0"
	},
	"devDependencies": {
		"typescript": "latest"
	}
}
