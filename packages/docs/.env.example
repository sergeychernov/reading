# Set to true to disable GitHub OAuth (useful for local dev and Vercel Preview;
# set to false or leave unset to enable auth).
DOCS_AUTH_DISABLED=

# GitHub OAuth (required when deploying with auth on Vercel, unless DOCS_AUTH_DISABLED is set)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

AUTH_SECRET=

# Repo for contributor check: if GITHUB_REPO_OWNER and GITHUB_REPO_NAME are set,
# only users who are contributors to this repo can access the docs.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Token with repo read (used by milestones script and by contributor check). For contributor
# check you can use GITHUB_REPO_ACCESS_TOKEN instead so it's separate from milestones.
GITHUB_TOKEN=